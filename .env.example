# ============================================================================
# JAL-SURAKSHA Environment Variables
# Copy this file to .env.local and adjust. No keys are required for the
# default setup — the live pipeline and map work with free, keyless APIs.
# ============================================================================

# ----------------------------------------------------------------------------
# LIVE RIVER DATA PIPELINE (defaults are free + keyless — see docs below)
# ----------------------------------------------------------------------------
# GloFAS global river discharge (ECMWF) via Open-Meteo Flood API.
# Docs: https://open-meteo.com/en/docs/flood-api  (CC BY 4.0, free, no key)
FLOOD_API_URL=https://flood-api.open-meteo.com/v1/flood

# Daily precipitation via Open-Meteo Weather API.
# Docs: https://open-meteo.com/en/docs  (CC BY 4.0, free, no key)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Optional API keys (skip when using the default keyless endpoints).
# Open-Meteo commercial keys: https://open-meteo.com/en/terms#api-pricing
OPEN_METEO_API_KEY=
FLOOD_API_KEY=
WEATHER_API_KEY=

# Upstream fetch settings (milliseconds / attempt count)
PIPELINE_FETCH_TIMEOUT_MS=10000
PIPELINE_CACHE_TTL_MS=120000

# ----------------------------------------------------------------------------
# MAP (MapLibre GL)
# ----------------------------------------------------------------------------
# Tile server. Default: OpenFreeMap Liberty (free, no key).
# Options that also work without keys:
#   https://tiles.openfreemap.org/styles/liberty
#   https://tiles.openfreemap.org/styles/positron
# Stadia Maps (needs the key below):
#   https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_TILE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_API_KEY=

# ----------------------------------------------------------------------------
# SUPABASE (optional; used for production persistence / auth)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# AI PROVIDER (optional)
# Options: "demo" | "openai" | "google-vision"
# ----------------------------------------------------------------------------
AI_PROVIDER=demo
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=

# ----------------------------------------------------------------------------
# APP
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000