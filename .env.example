# JAL-SURAKSHA Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase (required for production mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider configuration
# Options: "demo" | "openai" | "google-vision"
AI_PROVIDER=demo

# MapLibre tile server (optional - defaults to free OSM tiles)
NEXT_PUBLIC_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png

# MapLibre API key (required for Stadia Maps)
NEXT_PUBLIC_MAP_API_KEY=

# Application URL (for metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
